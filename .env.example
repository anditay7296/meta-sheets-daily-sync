# Copy this file to .env and fill in your own values. .env is gitignored.

# Meta Ads API access token (needs ads_read on every account in accounts.json)
META_TOKEN=your_meta_access_token_here

# Filename of your Google service-account JSON key, sitting next to this file
CREDS_FILE=gcp-creds.json

# The long id from your sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_ID=your_google_sheet_id_here
